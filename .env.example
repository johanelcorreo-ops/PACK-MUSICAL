# Tus carpetas de Google Drive, una por género, separadas por punto y coma.
# Puedes pegar el enlace completo de la carpeta o solo el ID.
GDRIVE_FOLDERS=Vallenato=https://drive.google.com/drive/folders/TU_ID; Reggae=https://drive.google.com/drive/folders/OTRO_ID

# (O, si solo tienes una carpeta)
# GDRIVE_FOLDER_ID=https://drive.google.com/drive/folders/TU_ID

# Opción A (fácil): API key de Google Cloud con "Google Drive API" activada.
# La carpeta debe estar compartida como "Cualquier persona con el enlace".
GOOGLE_API_KEY=

# Opción B (carpeta privada): JSON completo de una cuenta de servicio,
# en una sola línea. Comparte la carpeta con el email de la cuenta de servicio.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Segundos que suena cada canción antes de pasar a la siguiente (0 = completa)
PREVIEW_SECONDS=45
# Orden aleatorio (true/false)
SHUFFLE=true

# Textos de la página
SITE_TITLE=Pack Musical
SITE_SUBTITLE=Escucha una muestra del pack
# Botón de compra (déjalo vacío para ocultarlo)
BUY_URL=
BUY_TEXT=Comprar el pack

# ID numérico del píxel de Meta para campañas web (opcional)
# META_PIXEL_ID=
